# Obrigatória: chave da API da Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=
# Chave que protege o painel e a API (use algo longo)
API_KEY=troque-por-uma-chave-longa
# Postgres (na Vercel: conecte o Neon e ela preenche sozinha)
DATABASE_URL=
# Segredo do Vercel Cron (a Vercel envia como Bearer). Opcional se usar só GitHub Actions/X-API-Key
CRON_SECRET=
# Modelo usado para gerar os prompts
CLAUDE_MODEL=claude-sonnet-5-5
# 1 = não chama a IA, gera textos de teste
MOCK_LLM=0
