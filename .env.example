# Obrigatória: chave da API da Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=
# Chave que protege o painel e a API. Se ficar vazia, uma é gerada e salva em data/api_key.txt
API_KEY=troque-por-uma-chave-longa
# Modelo usado para gerar os prompts
CLAUDE_MODEL=claude-sonnet-5-5
# 1 = não chama a IA, gera textos de teste (só para testar o fluxo)
MOCK_LLM=0
